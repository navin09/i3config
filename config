# i3 config file (v4)
# See https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles. Also used by the bar unless overridden there.
font pango:DejaVu Sans Mono 10

#############
# Autostart #
#############

# Start XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3

# Lock the screen before suspend (via loginctl lock-session)
# Uses the same blurred-screenshot locker as the Ctrl+Alt+L binding
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock-fancy -g -- scrot -z

# NetworkManager tray applet
exec --no-startup-id nm-applet

# Notification daemon (replaces dunst; holds org.freedesktop.Notifications
# for the session so dunst never gets D-Bus-activated)
exec --no-startup-id /usr/lib/x86_64-linux-gnu/xfce4/notifyd/xfce4-notifyd

# File sync
exec --no-startup-id /home/navin/.local/bin/syncthing serve --no-browser --logfile=default

# Random desktop background
exec_always feh --randomize --bg-fill ~/Pictures/Backgrounds/Selected/*

# Battery warning popup
exec --no-startup-id ~/scripts/i3-battery-popup -L 35 -l 15 -t 5m -n -N -s ~/scripts/i3-battery-popup.wav

# Keep screensaver/DPMS from triggering while media is playing
exec --no-startup-id ~/scripts/screensaver-inhibit

# PolicyKit agent
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &

# GNOME Keyring
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh

####################
# Window behaviour #
####################

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding $mod.
tiling_drag modifier titlebar

# Window border size in pixels (0 turns off).
# Note: i3 hardcodes the title bar border to 1px, so 1px is the only
# border width at which title bar and content borders match.
new_window normal 1
new_float normal 1

# Default workspace layout
workspace_layout tabbed

# Custom title format
for_window [class=".*"] title_format "  %title"

# Custom floating windows
for_window [class="Gnome-calculator" instance="gnome-calculator"] floating enable

##################
# Basic keybinds #
##################

# Start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# Kill focused window
bindsym $mod+Shift+q kill

# Program launcher
bindsym $mod+d exec --no-startup-id rofi -theme gruvbox-dark-soft -show-icons -show drun

# Lock screen
bindsym Mod1+Control+l exec i3lock-fancy -g -- scrot -z

# Screenshot
bindsym --release Print exec scrot $HOME/Pictures/`date +%Y-%m-%d_%H:%M:%S`.png

# Inhibit/enable screensaver (e.g. during long playback)
bindsym $mod+F1 exec --no-startup-id "~/scripts/screensaver-control off"
bindsym $mod+F4 exec --no-startup-id "~/scripts/screensaver-control on"

# Reload the configuration file
bindsym $mod+Shift+c reload
# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart
# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

####################
# Focus and moving #
####################

# Change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal/vertical orientation
bindsym $mod+h split h
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Focus the parent container
bindsym $mod+a focus parent

##############
# Workspaces #
##############

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

###############
# Resize mode #
###############

bindsym $mod+r mode "resize"

mode "resize" {
        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # Same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

##########################
# Move floating windows  #
##########################

bindsym $mod+m mode "move" focus floating

mode "move" {
    bindsym $mod+Tab focus right

    bindsym Left  move left
    bindsym Down  move down
    bindsym Up    move up
    bindsym Right move right

    bindsym h     move left
    bindsym j     move down
    bindsym k     move up
    bindsym l     move right

    # Back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

###################
# Media and keys  #
###################

set $refresh_i3status killall -SIGUSR1 i3status

# Microphone mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Volume control (i3-volume script)
set $volumepath ~/scripts
set $statuscmd i3status
set $statussig SIGUSR1
set $volumestep 5

# -y: use dunstify so repeat presses update the existing notification
#     (replaces_id) instead of spawning new ones; works with any daemon
# -p: draw the progress bar as text (xfce4-notifyd hides the text when
#     it draws its own gauge from the int:value hint)
bindsym XF86AudioRaiseVolume exec --no-startup-id $volumepath/volume -y -p -n -t $statuscmd -u $statussig up $volumestep
bindsym XF86AudioLowerVolume exec --no-startup-id $volumepath/volume -y -p -n -t $statuscmd -u $statussig down $volumestep
bindsym XF86AudioMute        exec --no-startup-id $volumepath/volume -y -p -n -t $statuscmd -u $statussig mute

# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# Brightness (Redragon Kumara K552 keys and laptop keys)
bindsym XF86Search exec sudo brightnessctl -d "intel_backlight" set 10%-
bindsym XF86Calculator exec sudo brightnessctl -d "intel_backlight" set 10%+
bindsym XF86MonBrightnessDown exec --no-startup-id sudo brightnessctl -d "intel_backlight" set 10%-
bindsym XF86MonBrightnessUp exec --no-startup-id sudo brightnessctl -d "intel_backlight" set 10%+

#########
# Theme #
#########

set $red         #cc241d
set $purple      #b16286
set $darkgray    #1d2021
set $idle_bg     #313244
set $idle_fg     #cdd6f4
set $info_bg     #89b4fa
set $info_fg     #1e1e2e
set $good_bg     #a6e3a1
set $good_fg     #1e1e2e
set $critical_bg #f38ba8
set $critical_fg #1e1e2e

# Window decorations
#                       border    background   text         indicator  child_border
client.focused          $darkgray $info_bg     $info_fg     $purple    $darkgray
client.focused_inactive $darkgray $idle_bg     $idle_fg     $purple    $darkgray
client.unfocused        $darkgray $idle_bg     $idle_fg     $purple    $darkgray
client.urgent           $red      $critical_bg $critical_fg $red       $red

bar {
    font pango:DejaVu Sans Mono, FontAwesome 10
    position bottom
    status_command /home/navin/.cargo/bin/i3status-rs /home/navin/.config/i3status-rust/config.toml
    colors {
        background $idle_bg
        separator $critical_bg
        statusline $idle_fg
        focused_workspace $good_bg $good_bg $good_fg
        active_workspace $good_bg $good_bg $good_fg
        inactive_workspace $idle_bg $idle_bg $idle_fg
        urgent_workspace  $critical_fg $critical_bg $critical_fg
    }
}

